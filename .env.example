# Copy this file to .env.local for local dev (gitignored via the `*.local`
# rule) and set the same keys in the Vercel project's Environment Variables
# for deployment. Anything prefixed VITE_ is exposed to the browser bundle
# by Vite — never put a real secret behind that prefix.

# ── Mongo (api/assignments.js, api/curriculum.js, api/profile.js,
#    api/boardContent.js, api/checkedGoals.js, api/boardSettings.js) ─────
# One connection string, several collections — boardContent (a lesson's
# Essential Question/Agenda/Bell Ringer/Home Learning text + which Agenda
# lines are checked), checkedGoals (which learning goals a teacher's
# checked off), and boardSettings (wall/board-surface/arrangement/bulletin/
# sliding-boards/Board-Content-order preferences) are what moved that
# content off browser-only localStorage so it survives a different device
# or a cleared cache.
MONGODB_URI=
MONGODB_DB=homeroom

# ── Cloudinary (src/lib/cloudinary.js) — "bring your own PDF" uploads ──
# Unsigned upload preset, so only these two (non-secret) values are needed
# client-side. Create the preset in the Cloudinary dashboard under
# Settings → Upload → Upload presets, mode "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Clerk (src/boardConfig.js, main.jsx) — teacher accounts/login ──────
# From the Clerk dashboard (clerk.com) → your application → API Keys.
# The publishable key is safe in the browser bundle (VITE_ prefix, as
# above). CLERK_SECRET_KEY is NOT currently used anywhere — no server-side
# session verification exists yet (see the note in api/assignments.js);
# it's listed here so it's ready to wire in without a second round of
# dashboard setup once that hardening happens.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Google Drive Picker (src/lib/googleDrive.js) — pick Slides from Drive
#    instead of pasting a "Publish to web" link, in AddSlidesCard ────────
# Both values come from a Google Cloud Console project (console.cloud.
# google.com) — this is a real OAuth setup, not a copy-paste key like the
# others above:
#   1. Create/select a project, then enable the "Google Picker API" and
#      "Google Drive API" (APIs & Services → Library).
#   2. APIs & Services → Credentials → Create Credentials → OAuth client
#      ID → Web application. Add this app's origin(s) under "Authorized
#      JavaScript origins" (e.g. http://localhost:5173 for dev, the
#      Vercel prod URL for deployment) — no redirect URI needed, this uses
#      Google Identity Services' token flow, not a redirect. That's
#      VITE_GOOGLE_CLIENT_ID.
#   3. APIs & Services → Credentials → Create Credentials → API key.
#      Restrict it to the Picker API and the same origin(s) as step 2.
#      That's VITE_GOOGLE_API_KEY.
#   4. APIs & Services → OAuth consent screen: "Testing" mode is enough
#      for a small pilot (add each teacher's Google account as a test
#      user, up to 100) — publishing beyond that needs Google's app
#      verification, which is NOT required here because the scope this
#      uses (drive.file — access only to files a teacher explicitly picks)
#      is a "non-sensitive" scope.
# Both blank = the Drive picker silently doesn't appear; teachers still
# get the plain paste-a-link flow either way.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
